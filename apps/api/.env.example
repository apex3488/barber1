# =========================
# Supabase API
# =========================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...) — только сервер
SUPABASE_SERVICE_ROLE_KEY=""

# =========================
# PostgreSQL для Prisma
# =========================
# 1) Supabase → Connect → Method: Session pooler → Type: URI
# 2) Скопируй URI целиком
# 3) Замени только [YOUR-PASSWORD] на пароль БД
# 4) Вставь одну и ту же строку в оба поля ниже
#
# Пример готовой строки:
# postgresql://postgres.xxxxx:MY_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=""
DIRECT_URL=""

# =========================
# Apps
# =========================
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
PORT=3001
CORS_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# =========================
# Telegram (позже)
# =========================
TELEGRAM_BOT_TOKEN=""
