generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show
}

enum BookingSource {
  web
  telegram
  admin
}

enum TimeOffType {
  day_off
  vacation
  sick
  shop_closed
  other
}

model Barber {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  photoUrl        String?  @map("photo_url")
  bio             String?
  experienceYears Int      @default(0) @map("experience_years")
  telegramChatId  String?  @map("telegram_chat_id")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  portfolioItems PortfolioItem[]
  services       BarberService[]
  workingHours   WorkingHours[]
  breaks         Break[]
  timeOff        TimeOff[]
  bookings       Booking[]
  reviews        Review[]
  linkCodes      BarberLinkCode[]

  @@map("barbers")
}

model BarberLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  barberId  String    @map("barber_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_link_codes")
}

model PortfolioItem {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("portfolio_items")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  durationMin Int      @map("duration_min")
  price       Int
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  barbers  BarberService[]
  bookings BookingService[]

  @@map("services")
}

model BarberService {
  barberId    String  @map("barber_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  durationMin Int?    @map("duration_min")
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model WorkingHours {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  weekday   Int
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  weekday   Int
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

model TimeOff {
  id        String      @id @default(uuid()) @db.Uuid
  barberId  String?     @map("barber_id") @db.Uuid
  startsAt  DateTime    @map("starts_at")
  endsAt    DateTime    @map("ends_at")
  type      TimeOffType
  note      String?

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
  @@map("time_off")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String
  telegramId     String?  @unique @map("telegram_id")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at")

  bookings Booking[]
  reviews  Review[]

  @@index([phone])
  @@map("clients")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  clientId           String        @map("client_id") @db.Uuid
  barberId           String        @map("barber_id") @db.Uuid
  startsAt           DateTime                   @map("starts_at")
  endsAt             DateTime                   @map("ends_at")
  /// Заполняется триггером bookings_set_time_range
  timeRange          Unsupported("tstzrange")?  @map("time_range")
  totalPrice         Int                        @map("total_price")
  totalDurationMin   Int                        @map("total_duration_min")
  status             BookingStatus              @default(confirmed)
  source             BookingSource              @default(web)
  manageToken        String                     @unique @map("manage_token")
  createdAt          DateTime                   @default(now()) @map("created_at")
  reminderDaySentAt  DateTime?                  @map("reminder_day_sent_at")
  reminder30mSentAt  DateTime?                  @map("reminder_30m_sent_at")
  reviewRequestedAt  DateTime?                  @map("review_requested_at")
  autoCompletedAt    DateTime?                  @map("auto_completed_at")

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber   Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt, endsAt])
  @@index([status])
  @@map("bookings")
}

model BookingService {
  bookingId   String  @map("booking_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid
  name        String
  durationMin Int     @map("duration_min")
  price       Int

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@id([bookingId, name])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  rating    Int
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([barberId, isPublic])
  @@map("reviews")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AdminUser {
  id             String   @id @default(uuid()) @db.Uuid
  login          String   @unique
  passwordHash   String   @map("password_hash")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
