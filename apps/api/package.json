{
  "name": "@barber/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:race": "tsx src/tests/race-booking.ts",
    "notifications:run": "tsx src/scripts/run-notifications.ts",
    "admin:ensure": "tsx src/scripts/ensure-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "grammy": "^1.38.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
