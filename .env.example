# =========================
# Supabase API
# =========================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...) — только сервер
SUPABASE_SERVICE_ROLE_KEY=""

# =========================
# PostgreSQL для Prisma
# =========================
# 1) Supabase → Connect → Method: Session pooler → Type: URI
# 2) Скопируй URI целиком
# 3) Замени только [YOUR-PASSWORD] на пароль БД
# 4) Вставь одну и ту же строку в оба поля ниже
#
# Пример готовой строки:
# postgresql://postgres.xxxxx:MY_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=""
DIRECT_URL=""

# =========================
# Apps
# =========================
APP_URL="http://localhost:3000"
API_URL="http://localhost:3011"
PORT=3011
CORS_ORIGIN=""
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Адреса API на проде (Vercel). Локально можно оставить пустыми или указать localhost.
API_PROXY_URL=""
NEXT_PUBLIC_API_URL=""
VITE_API_URL=""

# =========================
# Telegram Bot + Mini App
# =========================
TELEGRAM_BOT_TOKEN=""
# HTTPS URL webhook, например https://api.example.com/telegram/webhook
# Если пусто — локальный long polling
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET="change_me"
MINIAPP_URL="http://localhost:5173"

# Cron / Edge Function notifications
CRON_SECRET="change_me_cron_secret"
